# Sony Xperia 10 VI (pdx246, columbia) on top of gki_defconfig and
# vendor/parrot_GKI.config: Sony's changes to parrot_GKI.config.

# Built in on the stock GKI kernel (as in nagara.config)
CONFIG_USB_DWC3_HAPS=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_QCOM=y

# Egis ET617 fingerprint sensor
CONFIG_FP_EC617=m

# Huaqin hardware_info
CONFIG_HQHARDWARE_INFO=m

# NXP NFC and eSE (both drivers build nfc_i2c.ko)
CONFIG_NFC_QTI_I2C=n
CONFIG_NXP_NFC_I2C=m
CONFIG_NXP_ESE_P73=m

CONFIG_QCOM_SOC_SLEEP_STATS_ON_SYSFS=y

# Not in Sony's config
CONFIG_QCOM_MEM_OFFLINE=n
CONFIG_QCOM_MINIDUMP_PSTORE=n
CONFIG_REGULATOR_QCOM_PM8008=n

# Build the device trees in arch/arm64/boot/dts/vendor (kernel/sony/sm6450-devicetrees)
# as base DTBs plus overlays, the way the bootloader expects them.
CONFIG_BUILD_ARM64_DT_OVERLAY=y
